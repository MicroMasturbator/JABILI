<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" android:elevation="2dp" />
    <HorizontalScrollView
        android:id="@+id/sortBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:visibility="gone">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortChips"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
