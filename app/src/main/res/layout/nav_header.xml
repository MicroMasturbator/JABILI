<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="140dp"
    android:background="?attr/colorPrimaryContainer"
    android:gravity="bottom" android:orientation="vertical" android:padding="20dp">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="24sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/navSite"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="?attr/colorOnPrimaryContainer" />
</LinearLayout>
